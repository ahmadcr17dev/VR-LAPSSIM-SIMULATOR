  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f4688fdb7df04437aeb418b961361dc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Unity.TextMeshPro::TMPro.TextMeshProUGUI
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: '<b><color=#4CAF50>Patient Preparation</color></b> involves proper <b>supine
    positioning</b>, administration of <b><color=#FF9800>general anesthesia</color></b>,
    and thorough <b>abdominal sterilization</b>. <b><color=#4CAF50>Port Placement</color></b>
    is performed by creating a <b>single umbilical incision</b> followed by careful
    insertion of the <b><color=#2196F3>SILS port</color></b>. During <b><color=#4CAF50>Exploration</color></b>,
    the <b>laparoscope</b> is introduced to accurately <b>identify the appendix</b>
    and assess the surgical field. The <b><color=#4CAF50>Appendectomy</color></b>
    phase includes <b>appendix isolation</b>, secure <b>vessel ligation</b>, and
    <b><color=#F44336>safe transection</color></b> of the appendix. Finally, <b><color=#4CAF50>Closure</color></b>
    involves careful <b>surgical field inspection</b>, <b>instrument removal</b>,
    and proper <b>wound closure</b> to complete the procedure.

'
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}

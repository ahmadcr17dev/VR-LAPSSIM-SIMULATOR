  m_Script: {fileID: 11500000, guid: f4688fdb7df04437aeb418b961361dc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Unity.TextMeshPro::TMPro.TextMeshProUGUI
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "<b><color=#FF9800>LAPSSIM</color></b> is a <b><color=#3AA6FF>Virtual Reality\u2013based</color></b>
    surgical training simulator designed to teach and refine the skills required
    for performing a <b><color=#4CAF50>Single-Incision Laparoscopic Appendectomy</color></b>.
    Developed using <b><color=#3AA6FF>Unity</color></b> and <b><color=#3AA6FF>Blender</color></b>,
    the system provides an immersive, interactive, and safe environment for learners
    to practice surgical procedures without real-world risks. Supporting both <b><color=#FF9800>VR
    headsets</color></b> and <b><color=#FF9800>laptop-based controls</color></b>,
    LAPSSIM enhances accessibility while improving hand\u2013eye coordination, procedural
    understanding, and surgical precision. By simulating realistic surgical steps
    and operating room interactions, the simulator serves as an effective educational
    tool for medical students and healthcare professionals seeking to enhance their
    competence in a controlled setting.\r\n\r\n<b><color=#FF3333>\xA9 2025 LAPSSIM
    \u2014 All Rights Reserved.</color></b>\r\n"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
